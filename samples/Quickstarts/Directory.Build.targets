<Project>

    <PropertyGroup>
        <AspNetVersion>10.0.11</AspNetVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Update="IdentityModel" Version="6.2.0" />
        <PackageReference Update="ForgePoint.Identity" Version="10.0.0-*" />
        <PackageReference Update="ForgePoint.Identity.EntityFramework" Version="10.0.0-*" />
        <PackageReference Update="ForgePoint.Identity.AspNetIdentity" Version="10.0.0-*" />

        <PackageReference Update="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="$(AspNetVersion)" />
        <PackageReference Update="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(AspNetVersion)" />
        <PackageReference Update="Microsoft.AspNetCore.Authentication.Google" Version="$(AspNetVersion)" />
        <PackageReference Update="Microsoft.EntityFrameworkCore.SqlServer" Version="$(AspNetVersion)" />
        <PackageReference Update="Microsoft.EntityFrameworkCore.Design" Version="$(AspNetVersion)" />

        <PackageReference Update="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />

        <PackageReference Update="Serilog.AspNetCore" Version="9.0.0" />
    </ItemGroup>
</Project>
